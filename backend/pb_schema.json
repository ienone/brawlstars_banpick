{
  "collections": [
    {
      "name": "users",
      "type": "auth",
      "schema": [
        { "name": "username", "type": "text", "required": true },
        { "name": "avatar", "type": "file", "required": false },
        { "name": "role", "type": "select", "options": { "values": ["player", "coach", "admin"] } }
      ]
    },
    {
      "name": "brawlers",
      "type": "base",
      "schema": [
        { "name": "bid", "type": "text", "required": true },
        { "name": "name_en", "type": "text", "required": true },
        { "name": "name_cn", "type": "text" },
        { "name": "rarity", "type": "text" },
        { "name": "color", "type": "text" },
        { "name": "image_url", "type": "url" }
      ]
    },
    {
      "name": "maps",
      "type": "base",
      "schema": [
        { "name": "name", "type": "text", "required": true },
        { "name": "mode", "type": "text" },
        { "name": "image_url", "type": "url" },
        { "name": "active", "type": "bool" }
      ]
    },
    {
      "name": "rooms",
      "type": "base",
      "schema": [
        { "name": "hostId", "type": "text" },
        { "name": "inviteCode", "type": "text" },
        { "name": "status", "type": "select", "options": { "values": ["waiting", "active", "finished"] } },
        { "name": "config", "type": "json" },
        { "name": "seats", "type": "json" },
        { "name": "bpState", "type": "json" }
      ]
    },
    {
      "name": "match_history",
      "type": "base",
      "schema": [
        { "name": "roomId", "type": "text" },
        { "name": "mapName", "type": "text" },
        { "name": "blueBans", "type": "json" },
        { "name": "redBans", "type": "json" },
        { "name": "bluePicks", "type": "json" },
        { "name": "redPicks", "type": "json" },
        { "name": "winner", "type": "text" },
        { "name": "createdAt", "type": "date" }
      ]
    }
  ]
}
